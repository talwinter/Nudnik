# Nudnik configuration.
#
# These values only SEED the database on first run. After that the admin UI at
# /#/settings owns them, so you can rewire channels without a redeploy.
# Leave a value blank rather than filling in a placeholder -- a placeholder
# seeds a broken channel that then silently fails.

# --- core -------------------------------------------------------------------
# The origin the Done/Snooze buttons in notifications point at. MUST be your
# real HTTPS address, or one-tap actions from email/Telegram will not work.
PUBLIC_URL=https://nudnik.example.com

DEFAULT_TZ=Asia/Jerusalem
DEFAULT_LANG=he

# REQUIRED if this is reachable from the internet (a tunnel counts).
#
# Blank means NO authentication at all: anyone who finds the URL can read and
# change your reminders and settings. Notification action links and the
# calendar feed keep working when it is set -- they carry their own tokens.
ADMIN_PASSWORD=

# --- docker -----------------------------------------------------------------
POSTGRES_PASSWORD=change-me

# Only used with the localports override, for debugging. In normal operation no
# ports are published at all -- the tunnel reaches containers by name:
#   nudnik.example.com -> http://nudnik-app:8000
APP_PORT=8080
NTFY_PORT=8081

# Only for the cloudflared stack in deploy/docker-compose.cloudflared.yml.
# Anyone holding this can receive your tunnel's traffic. Treat it like a key.
CLOUDFLARE_TUNNEL_TOKEN=

# Only used with the Caddy override (a VPS with a public IP).
DOMAIN=nudnik.example.com
NTFY_DOMAIN=ntfy.example.com
NTFY_PUBLIC_URL=https://ntfy.example.com

# --- Web Push ---------------------------------------------------------------
# Generated automatically on first run and stored in the database. Set these
# only if you want to pin a specific keypair (e.g. migrating servers without
# forcing every device to re-subscribe).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- ntfy (self-hosted push) ------------------------------------------------
NTFY_URL=http://ntfy:80
NTFY_TOPIC=
NTFY_TOKEN=

# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather. Send /start to the bot once the webhook is
# registered and it will learn your chat id by itself.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# --- Gotify / Matrix (both self-hostable) -----------------------------------
GOTIFY_URL=
GOTIFY_TOKEN=
MATRIX_HOMESERVER=
MATRIX_TOKEN=
MATRIX_ROOM=

# --- Webhook (Discord, Slack, Home Assistant, n8n, anything) ----------------
WEBHOOK_URL=

# --- Twilio SMS / WhatsApp (the only paid option here) ----------------------
TWILIO_SID=
TWILIO_AUTH=
TWILIO_FROM=
TWILIO_TO=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=

# --- API --------------------------------------------------------------------
# Generated on first run if blank. Used for the external tick endpoint and the
# Telegram webhook path.
API_KEY=
